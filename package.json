  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "auth:generate": "auth generate --adapter drizzle --dialect postgresql --config src/infrastructure/auth/better-auth.ts --output src/infrastructure/database/auth-schema.ts -y",
