# Database
DATABASE_URL=postgresql://leiloeiro:leiloeiro@localhost:5432/leiloeironerd

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=<openssl rand -hex 32>
BETTER_AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UploadThing (uploadthing v7 usa UPLOADTHING_TOKEN; gere em https://uploadthing.com/dashboard)
UPLOADTHING_TOKEN=uttoken_xxx

# Mercado Pago (ativa a partir da Fase 3)
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxx
MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
MERCADO_PAGO_WEBHOOK_SECRET=xxxx

# Resend (outbid já ativo; demais templates transacionais na Fase 3)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=Leiloeiro Nerd <noreply@leiloeironerd.com>

# Chatbot (assistente virtual). Gere a chave em https://openrouter.ai/keys
# Sem a chave o widget abre, mas responde com erro amigável.
OPENROUTER_API_KEY=sk-or-xxxx
# Opcional (padrão: openrouter/auto, o roteador que escolhe o modelo disponível).
# Para fixar um modelo, use o slug completo, ex.: "google/gemini-2.0-flash-001".
OPENROUTER_MODEL=openrouter/auto

# RAG do chatbot (base de conhecimento em knowledge/*.md).
# Embeddings usam o endpoint compatível com OpenAI do Google Gemini (camada
# gratuita), NÃO a OpenRouter — a OpenRouter não garante endpoint de embeddings.
# Gere a chave em https://aistudio.google.com/apikey; é independente da
# OPENROUTER_API_KEY acima.
OPENAI_GEMINI_API_KEY=AIza-xxxx
# Opcional (padrão: gemini-embedding-001). Trocar exige rodar
# "pnpm knowledge:index" de novo.
OPENAI_EMBEDDING_MODEL=gemini-embedding-001
# Opcional. Base URL da API de embeddings (padrão: endpoint compatível com
# OpenAI do Gemini). Para usar a OpenAI de verdade:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Opcional. Quantos chunks, no máximo, a busca retorna (padrão: 5).
RAG_TOP_K=5
# Opcional. Similaridade mínima de 0 a 1 para um chunk ser relevante (padrão: 0.7).
RAG_MIN_SCORE=0.7
